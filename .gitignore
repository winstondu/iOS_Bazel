# Everything below is generated or machine-local. Regenerate it with
# ./tools/setup-tooling.sh and Bazel; see "Generated and ignored files" in READMe.md.
# Keep MODULE.bazel.lock, Package.swift, and Package.resolved tracked.

### Bazel ###
# Convenience symlinks into the output base (bazel-bin, bazel-out, bazel-testlogs, bazel-<repo>).
/bazel-*
# Generated Xcode project (bazel run //:xcodeproj).
/*.xcodeproj

### SourceKit-LSP / BSP (written by bazel run //tools:setup_sourcekit_bsp) ###
# BSP executable copy, skbsp.json, and the generated skbsp_generated package.
/.bsp/
# config.json holds index prefix maps with absolute output-base paths.
/.sourcekit-lsp/
# SourceKit-LSP's SwiftPM fallback build directory, if it ever activates.
/.index-build/

### SwiftPM (root Package.swift only declares dependencies; Bazel builds the app) ###
/.build/
/.swiftpm/

### Project-local tools and scratch (see AGENTS.md) ###
/.tools/
/.artifacts/
/.worktrees/

### Editors ###
# settings.json is generated by merging tools/vscode-settings.json into personal settings.
/.vscode/*
!/.vscode/extensions.json
.buildServer
buildServer.json
.claude/settings.local.json

### Xcode ###
xcuserdata/
DerivedData/
build/
*.xcscmblueprint
*.xccheckout
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

### Build outputs ###
*.ipa
*.dSYM
*.dSYM.zip

### Secrets ###
.env*
!.env.example

